{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-plain.xml", "destination": "/api/sitemap-plain" },
    { "source": "/health-sitemap", "destination": "/api/health-sitemap" },
    {
      "source": "/((?!api/|_next/|sitemap\\.xml|sitemap-plain\\.xml|health-sitemap|robots\\.txt|public/).*)",
      "destination": "/"
    }
  ]
}
