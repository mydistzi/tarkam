# Frontend
VITE_DISQUS_SHORTNAME=tarkam
BASE_URL=https://tarkam.fun
API_BASE_URL=https://tarkam-api-web-production.up.railway.app/api/v1
PORT=3001

# Baileys bridge
BAILEYS_HOST=0.0.0.0
BAILEYS_PORT=3010
BAILEYS_API_TOKEN=
BAILEYS_LOG_LEVEL=info
BAILEYS_MESSAGE_CACHE_SIZE=1000
BAILEYS_DATA_DIR=/data
BAILEYS_PUBLIC_BASE_URL=https://example-baileys.up.railway.app
BAILEYS_HOSTED_MEDIA_MAX_AGE_MS=300000
BAILEYS_NSFW_GROUP_STATUS_CACHE_TTL_MS=60000

# Outbound webhook to tarkam-bot
TARKAM_BOT_WEBHOOK_URL=http://127.0.0.1:8080/webhook
TARKAM_BOT_WEBHOOK_SECRET=<shared-webhook-secret>
WEBHOOK_SECRET=<shared-webhook-secret>
