{
  "name": "tarkam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:admin": "npm --prefix ../tarkam-admin run build",
    "build:all": "npm run build && npm run build:admin",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node sitemap-server.js",
    "sitemap:dev": "cross-env BASE_URL=http://localhost:5173 node sitemap-server.js",
    "whatsapp:baileys": "node baileys/server.js",
    "start:services": "concurrently \"npm run dev\" \"npm run whatsapp:baileys\""
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.21",
    "axios": "^1.13.6",
    "disqus-react": "^1.1.7",
    "express": "^5.2.1",
    "laravel-echo": "^2.3.4",
    "pino": "^9.14.0",
    "prop-types": "^15.8.1",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-multi-carousel": "^2.8.6",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "sitemap": "^9.0.1",
    "sweetalert2": "^11.26.22",
    "swiper": "^12.1.3",
    "use-local-storage": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
